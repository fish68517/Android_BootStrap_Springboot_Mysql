<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when the button is checked (favorited) -->
    <item android:color="@color/red_favorite" android:state_checked="true" />

    <!-- Default state when the button is not checked -->
    <item android:color="@color/gray_medium_emphasis" android:state_checked="false"/>
</selector>